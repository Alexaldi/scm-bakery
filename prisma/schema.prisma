generator client {
  provider            = "prisma-client"
  output              = "./generated/client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Validasi rentang qualityScore, stok non-negatif, shelfLifeDays positif, dan
/// leadTimeDays non-negatif akan ditambahkan di layer server saat CRUD dimigrasikan.
enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id            String                    @id @default(cuid())
  code          String                    @unique
  name          String
  category      String
  sellingPrice  Decimal                   @db.Decimal(12, 2)
  unit          String
  shelfLifeDays Int
  status        RecordStatus              @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  bomItems      BillOfMaterial[]
  sales         Sale[]
  inventory     FinishedProductInventory?
}

model RawMaterial {
  id                String                @id @default(cuid())
  code              String                @unique
  name              String
  category          String
  inventoryUnit     String
  warehouseLocation String
  status            RecordStatus          @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  bomItems          BillOfMaterial[]
  supplierMaterials SupplierMaterial[]
  inventory         RawMaterialInventory?
}

model BillOfMaterial {
  id                 String      @id @default(cuid())
  productId          String
  rawMaterialId      String
  quantityPerProduct Decimal     @db.Decimal(12, 4)
  usageUnit          String
  inventoryUnit      String
  conversionFactor   Decimal     @db.Decimal(12, 6)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterial        RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, rawMaterialId])
  @@index([productId])
  @@index([rawMaterialId])
}

model Supplier {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  contactPerson     String
  phone             String
  email             String?
  address           String
  distanceKm        Decimal            @db.Decimal(8, 2)
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  supplierMaterials SupplierMaterial[]
}

model SupplierMaterial {
  id            String       @id @default(cuid())
  supplierId    String
  rawMaterialId String
  price         Decimal      @db.Decimal(12, 2)
  qualityScore  Int
  capacity      Decimal      @db.Decimal(12, 2)
  minimumOrder  Decimal      @db.Decimal(12, 2)
  leadTimeDays  Int
  unit          String
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  supplier      Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  rawMaterial   RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([supplierId, rawMaterialId])
  @@index([supplierId])
  @@index([rawMaterialId])
}

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  customerType  String
  contactPerson String
  phone         String
  address       String
  region        String
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Sale {
  id           String   @id @default(cuid())
  productId    String
  period       DateTime
  quantitySold Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, period])
  @@index([productId])
  @@index([period])
}

model RawMaterialInventory {
  id               String      @id @default(cuid())
  rawMaterialId    String      @unique
  currentStock     Decimal     @db.Decimal(12, 2)
  safetyStock      Decimal     @db.Decimal(12, 2)
  minimumStock     Decimal     @db.Decimal(12, 2)
  incomingQuantity Decimal     @db.Decimal(12, 2)
  outgoingQuantity Decimal     @db.Decimal(12, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  rawMaterial      RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
}

model FinishedProductInventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  currentStock  Decimal  @db.Decimal(12, 2)
  reservedStock Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}
